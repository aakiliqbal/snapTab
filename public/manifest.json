{
  "manifest_version": 3,
  "name": "SnapTab",
  "description": "A customizable local-first new tab page.",
  "version": "1.0.0",
  "action": {
    "default_title": "Add to SnapTab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
